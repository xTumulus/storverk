{
  "name": "personal-site",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "init-content": "node scripts/init-content.ts",
    "predev": "node scripts/init-content.ts && node scripts/build-content.ts",
    "dev": "vite",
    "prebuild": "node scripts/init-content.ts && node scripts/build-content.ts",
    "build": "vue-tsc -b && vite-ssg build",
    "postbuild": "node scripts/build-sitemap.ts",
    "preview": "vite preview",
    "fetch:github": "node scripts/fetch-github-readmes.ts",
    "generate:resume": "node scripts/generate-resume-content.ts",
    "pretest": "node scripts/init-content.ts && node scripts/build-content.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@material-symbols/svg-400": "^0.45.10",
    "@unhead/vue": "^2.1.17",
    "simple-icons": "^16.28.0",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.7.16",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.3",
    "markdown-it": "^15.0.0",
    "prettier": "^3.9.6",
    "sanitize-html": "^2.17.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8",
    "zod": "^3.25.76"
  }
}
